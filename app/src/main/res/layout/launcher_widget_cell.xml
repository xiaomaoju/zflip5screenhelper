<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/launcher_cell"
    android:layout_width="1dp" android:layout_height="1dp" android:layout_gravity="top|left"
    android:orientation="vertical" android:gravity="center" android:padding="2dp" android:focusable="true">
    <ImageView android:id="@+id/launcher_icon" android:layout_width="30dp" android:layout_height="30dp" android:scaleType="fitCenter" android:importantForAccessibility="no" />
    <TextView android:id="@+id/launcher_label" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="2dp" android:gravity="center" android:singleLine="true" android:ellipsize="end" android:includeFontPadding="false" android:textSize="9sp" android:textColor="#F2F5F8" android:importantForAccessibility="no" />
</LinearLayout>
